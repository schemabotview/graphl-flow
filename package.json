{
  "name": "@graphlearning/graphl-flow",
  "version": "0.1.0",
  "description": "Declarative diagram engine — authors describe groups, items and edges; the browser lays them out and the engine draws the edges.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schemabotview/graphl-flow.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly && cp src/styles.css dist/styles.css",
    "watch": "vite build --watch",
    "prepublishOnly": "npm run build",
    "capture": "node scripts/capture.mjs",
    "check": "node scripts/check.mjs"
  },
  "peerDependencies": {
    "lucide-react": "^1.28.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^1.28.0",
    "playwright": "1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@threeveloper/azure-react-icons": "^1.1.1",
    "aws-react-icons": "^3.3.0",
    "simple-icons": "^16.36.0"
  }
}
